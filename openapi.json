  "info": {
    "description": "as-of 피처로 만든 숙박 수요 예측을 조회한다.",
    "title": "Demand Forecast API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/forecast": {
      "get": {
        "operationId": "forecast_forecast_get",
        "parameters": [
          {
            "description": "지역으로 거른다",
            "in": "query",
            "name": "region",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "지역으로 거른다",
              "title": "Region"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 200,
              "maximum": 2000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Forecast",
        "tags": [
          "forecast"
        ]
      }
    },
    "/forecast/low-demand": {
      "get": {
        "description": "수요가 낮게 예측된 숙소·날짜.\n\n콘솔이 이걸 받아 콘텐츠 생성으로 넘긴다.",
        "operationId": "low_demand_forecast_low_demand_get",
        "parameters": [
          {
            "description": "이 값 미만을 낮은 수요로 본다",
            "in": "query",
            "name": "threshold",
            "required": false,
            "schema": {
              "default": 1.0,
              "description": "이 값 미만을 낮은 수요로 본다",
              "minimum": 0,
              "title": "Threshold",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "region",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Region"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LowDemandResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Low Demand",
        "tags": [
          "forecast"
        ]
      }
    },
    "/forecast/segments": {
      "get": {
        "description": "지역별 오차.\n\n전체 WAPE 만 보면 희박한 지역이 가려진다. 평균 뒤에 무엇이 숨어 있는지를\n같이 내보내는 게 이 프로젝트의 규칙이라 API 에서도 그대로 한다.",
        "operationId": "segments_forecast_segments_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SegmentResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Segments",
        "tags": [
          "forecast"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/metrics": {

          "threshold": {
            "description": "이 값 미만을 낮은 수요로 본다",
            "title": "Threshold",
            "type": "number"
          }
        },
        "required": [
          "threshold",
          "count",
          "measured_on",
          "rows"
        ],
        "title": "LowDemandResponse",
        "type": "object"
      },
      "LowDemandRow": {
        "description": "수요가 낮게 예측된 숙소·날짜 하나.\n\n**예측값만 실어 보내지 않는다.** 이 응답의 소비자는 사람이 아니라 조정자이고,\n조정자는 이 행을 받아 할인을 승인할지 사람에게 넘길지를 정한다. 그런데\n\"0.4개 예약\" 이라는 숫자 하나만으로는 그 결정을 할 수 없다 — 그 구간에서\n모델이 평균 40% 씩 틀린다면 0.4 는 사실상 아무 말도 아니기 때문이다.\n\n그래서 그 구간의 오차를 **같이 싣는다.** 옵션이 아니라 필수 필드다.",
        "properties": {
          "predicted": {
            "title": "Predicted",
            "type": "number"
          },
          "property_id": {
            "title": "Property Id",
            "type": "string"
          },
          "region": {
            "title": "Region",
            "type": "string"
          },
          "region_n": {
            "description": "이 지역의 검증 표본 수",
            "title": "Region N",
            "type": "integer"
          },
          "region_wape": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "이 지역의 WAPE. null 이면 잴 표본이 없었다는 뜻 — 0 이 아니다",
            "title": "Region Wape"
          },
          "stay_date": {
            "format": "date",
            "title": "Stay Date",
            "type": "string"
          }
        },
        "required": [
          "property_id",
          "region",
          "stay_date",
          "predicted",
          "region_wape",
          "region_n"
        ],
        "title": "LowDemandRow",
        "type": "object"
      },
      "MetricsResponse": {
        "properties": {
          "baseline": {
            "title": "Baseline",

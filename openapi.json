  "info": {
    "description": "as-of 피처로 만든 숙박 수요 예측을 조회한다.",
    "title": "Demand Forecast API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/forecast": {
      "get": {
        "operationId": "forecast_forecast_get",
        "parameters": [
          {
            "description": "지역으로 거른다",
            "in": "query",
            "name": "region",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "지역으로 거른다",
              "title": "Region"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 200,
              "maximum": 2000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Forecast",
        "tags": [
          "forecast"
        ]
      }
    },
    "/forecast/low-demand": {
      "get": {
        "description": "수요가 낮게 예측된 숙소·날짜.\n\n콘솔과 조정자가 이걸 받아 개입 대상으로 넘긴다.\n\n**예측값과 그 구간의 오차를 같이 낸다.** 낮은 예측 하나만으로는 행동할 수\n없다는 것을 스키마가 강제한다 — 소비자가 오차를 안 보고 결정하려면 필드를\n일부러 무시해야 하고, 그건 코드에 흔적이 남는다.\n\n거르지는 않는다. \"WAPE 가 높으니 이 행은 빼자\" 는 **소비자의 정책**이지\n예측 서비스가 대신 정할 일이 아니다. 여기서 걸러 버리면 조정자는 자기가 무엇을\n못 봤는지조차 모른다.",
        "operationId": "low_demand_forecast_low_demand_get",
        "parameters": [
          {
            "description": "이 값 미만을 낮은 수요로 본다",
            "in": "query",
            "name": "threshold",
            "required": false,
            "schema": {
              "default": 1.0,
              "description": "이 값 미만을 낮은 수요로 본다",
              "minimum": 0,
              "title": "Threshold",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "region",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Region"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LowDemandResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Low Demand",
        "tags": [
          "forecast"
        ]
      }
    },
    "/forecast/segments": {
      "get": {
        "description": "세그먼트별 오차.\n\n전체 WAPE 만 보면 희박한 구간이 가려진다. 평균 뒤에 무엇이 숨어 있는지를\n같이 내보내는 게 이 프로젝트의 규칙이라 API 에서도 그대로 한다.\n\n**축이 하나면 그 규칙이 반쪽이다.** 지역만 볼 수 있으면 특정 숙소 유형에서만\n무너지는 모델을 지역 평균이 덮어 가린다. 그래서 축을 파라미터로 연다.",
        "operationId": "segments_forecast_segments_get",
        "parameters": [
          {
            "description": "쪼갤 축. region | property_type",
            "in": "query",
            "name": "by",
            "required": false,
            "schema": {
              "default": "region",
              "description": "쪼갤 축. region | property_type",
              "title": "By",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SegmentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Segments",
        "tags": [
          "forecast"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/metrics": {
      "get": {
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics",
        "tags": [
          "metrics"
        ]
      }
    }
  }
}
